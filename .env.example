# --- Redis Cloud (Databases > tu base > Connect > Redis CLI / Public endpoint) ---
# Formato: redis://default:<PASSWORD>@<HOST>:<PORT>   (usa rediss:// si activaste TLS)
REDIS_URL=

# --- Riot Games API (https://developer.riotgames.com) -----------------------
# La development key expira cada 24 h: regénérala el día del examen.
RIOT_API_KEY=
RIOT_PLATFORM=la1        # LAN (la2 = LAS, na1 = NA)
RIOT_REGION=americas     # routing regional para account-v1 y match-v5

# --- Opcionales (valores por defecto) ---------------------------------------
# MATCH_QUEUE=420          # 420 = Ranked Solo/Duo, 0 = cualquier cola
# TTL_ACCOUNT=86400
# TTL_SUMMONER=3600
# TTL_LEAGUE=600
# TTL_MATCH_IDS=120
# TTL_NEGATIVE=60
# SYNC_COOLDOWN=60
